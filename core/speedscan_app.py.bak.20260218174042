#!/usr/bin/env python3
# SpeedScan - Versão final com sidebar centralizada e coleta robusta de hardware
# Uso: python3 core/speedscan_app.py

import customtkinter as ctk
import os
import platform
import psutil
import subprocess
import threading
import json
import time
import sys
from PIL import Image
from datetime import datetime

# Configurações
CONFIG_FILE = os.path.expanduser("~/.speedscan_conf")
ICON_PATH = os.path.expanduser("~/speedscan/icon.png")

def get_config():
    if os.path.exists(CONFIG_FILE):
        try:
            with open(CONFIG_FILE, "r") as f:
                return json.load(f)
        except:
            pass
    return {
        "theme": "default",
        "username": "ewerton",
        "language": "pt_BR",
        "ui_scale": "auto",
        "open_file_in_tab": False
    }

conf = get_config()

themes = {
    "default": {"mode": "dark", "bg": "#1e293b", "side": "#0f172a", "acc": "#a855f7", "text": "#ffffff"},
    "grey":    {"mode": "light", "bg": "#d1d5db", "side": "#374151", "acc": "#4b5563", "text": "#111827"},
    "dark":    {"mode": "dark", "bg": "#080808", "side": "#000000", "acc": "#10b981", "text": "#ffffff"},
    "light":   {"mode": "light", "bg": "#ffffff", "side": "#f8fafc", "acc": "#2563eb", "text": "#0f172a"}
}

languages = {
    "pt_BR": "Português Brasileiro",
    "en_US": "English (US)",
    "es_ES": "Español"
}

scales = {
    "auto": "Automático",
    "100": "100%",
    "125": "125%",
    "150": "150%"
}

AI_SUGGESTIONS = [
    "DeepSeek",
    "OpenAI GPT-4",
    "Google Gemini",
    "Claude (Anthropic)",
    "Llama 3 (Meta)",
    "Mistral AI",
    "Cohere",
    "Local (Ollama)"
]

class SpeedScan(ctk.CTk):
    def __init__(self):
        super().__init__()
        self.SO = platform.system()
        self.config = conf
        self.update_theme_vars()
        self.title("SpeedScan")
        self.geometry("1200x950")
        self.minsize(1000, 700)
        self.configure(fg_color=self.bg_color)

        self.apply_ui_scale()

        self.turbo_active = False
        self.consoles_visible = {}
        self.ping_active = False
        self.current_module = None

        self.grid_columnconfigure(1, weight=1)
        self.grid_rowconfigure(0, weight=1)

        # Sidebar
        self.sidebar = ctk.CTkFrame(self, width=220, corner_radius=0, fg_color=self.side_bg)
        self.sidebar.grid(row=0, column=0, sticky="nsew")
        self.sidebar.grid_propagate(False)

        # Container principal
        self.container = ctk.CTkFrame(self, fg_color="transparent")
        self.container.grid(row=0, column=1, sticky="nsew", padx=20, pady=20)
        self.container.grid_columnconfigure(0, weight=1)
        self.container.grid_rowconfigure(0, weight=1)

        self.frames = {}

        self.create_sidebar()
        self.create_frames()

        self.show_frame("sistema")

        self.bind_all("<MouseWheel>", self._on_mousewheel)

        # Inicia monitoramento em thread separada
        self.monitor_running = True
        threading.Thread(target=self.hardware_monitor, daemon=True).start()

    def update_theme_vars(self):
        t = themes.get(self.config["theme"], themes["default"])
        ctk.set_appearance_mode(t["mode"])
        self.bg_color = t["bg"]
        self.side_bg = t["side"]
        self.acc_color = t["acc"]
        self.text_color = t["text"]

    def apply_ui_scale(self):
        scale = self.config.get("ui_scale", "auto")
        if scale == "auto":
            ctk.set_widget_scaling(1.0)
        else:
            ctk.set_widget_scaling(float(scale) / 100)

    def create_sidebar(self):
        # Topo: SpeedScan
        top_frame = ctk.CTkFrame(self.sidebar, fg_color="transparent")
        top_frame.pack(side="top", fill="x", pady=(30, 10))

        icon_image = None
        if os.path.exists(ICON_PATH):
            try:
                icon_image = ctk.CTkImage(Image.open(ICON_PATH), size=(48, 48))
            except:
                pass

        if icon_image:
            btn_speed = ctk.CTkButton(
                top_frame,
                image=icon_image,
                text="",
                width=48,
                height=48,
                fg_color="transparent",
                hover_color=self.acc_color,
                command=lambda: self.show_frame("sistema")
            )
            btn_speed.pack()
        else:
            btn_speed = ctk.CTkButton(
                top_frame,
                text="⚡",
                width=48,
                height=48,
                fg_color="transparent",
                hover_color=self.acc_color,
                font=("Inter", 24),
                command=lambda: self.show_frame("sistema")
            )
            btn_speed.pack()

        ctk.CTkLabel(top_frame, text="SpeedScan", font=("Inter", 12, "bold"), text_color=self.acc_color).pack(pady=(5, 0))

        # Frame central (expande para empurrar o inferior)
        center_frame = ctk.CTkFrame(self.sidebar, fg_color="transparent")
        center_frame.pack(side="top", fill="both", expand=True, pady=10)

        # Botões centrais
        self.add_sidebar_btn(center_frame, "🚀", "Otimização", "otimizacao")
        self.add_sidebar_btn(center_frame, "🌐", "Rede", "rede")
        self.add_sidebar_btn(center_frame, "🛠️", "Drivers", "drivers")
        self.add_sidebar_btn(center_frame, "🤖", "Agente IA", "agente")

        # Frame inferior (fixo no rodapé)
        bottom_frame = ctk.CTkFrame(self.sidebar, fg_color="transparent")
        bottom_frame.pack(side="bottom", fill="x", pady=20)

        self.add_sidebar_btn(bottom_frame, "⚙️", "Configurações", "config")
        self.add_sidebar_btn(bottom_frame, "ℹ️", "Sobre", "sobre")

    def add_sidebar_btn(self, parent, icon, text, target):
        frame = ctk.CTkFrame(parent, fg_color="transparent")
        frame.pack(pady=5, fill="x", padx=10)
        btn = ctk.CTkButton(
            frame,
            text=f"{icon}  {text}",
            anchor="w",
            height=40,
            fg_color="transparent",
            hover_color=self.acc_color,
            font=("Inter", 13),
            command=lambda: self.show_frame(target)
        )
        btn.pack(fill="x")
        return btn

    def show_frame(self, target):
        for frame in self.frames.values():
            frame.pack_forget()
        self.frames[target].pack(fill="both", expand=True)
        self.current_module = target

    def create_frames(self):
        self.frames["sistema"] = ctk.CTkScrollableFrame(self.container, fg_color="transparent")
        self.create_sistema_frame(self.frames["sistema"])

        self.frames["otimizacao"] = ctk.CTkFrame(self.container, fg_color="transparent")
        self.create_otimizacao_frame(self.frames["otimizacao"])

        self.frames["rede"] = ctk.CTkScrollableFrame(self.container, fg_color="transparent")
        self.create_rede_frame(self.frames["rede"])

        self.frames["drivers"] = ctk.CTkScrollableFrame(self.container, fg_color="transparent")
        self.create_drivers_frame(self.frames["drivers"])

        self.frames["agente"] = ctk.CTkScrollableFrame(self.container, fg_color="transparent")
        self.create_agente_frame(self.frames["agente"])

        self.frames["config"] = ctk.CTkScrollableFrame(self.container, fg_color="transparent")
        self.create_config_frame(self.frames["config"])

        self.frames["sobre"] = ctk.CTkFrame(self.container, fg_color="transparent")
        self.create_sobre_frame(self.frames["sobre"])

    # ---------- Sistema (cards de informações) ----------
    def create_sistema_frame(self, parent):
        ctk.CTkLabel(parent, text="Informações do Sistema", font=("Inter", 28, "bold"), text_color=self.acc_color).pack(anchor="w", pady=(0, 30))

        grid = ctk.CTkFrame(parent, fg_color="transparent")
        grid.pack(fill="both", expand=True)
        for i in range(3):
            grid.columnconfigure(i, weight=1)

        info_fields = [
            ("💻 Marca", "marca"),
            ("💻 Hostname", "hostname"),
            ("💿 Distribuição", "distro"),
            ("🐧 Kernel", "kernel"),
            ("🖥️ CPU", "cpu"),
            ("📟 RAM", "ram"),
            ("🎮 GPU", "gpu"),
            ("💽 Discos", "disks"),
            ("⏱️ Uptime", "uptime"),
            ("🔋 Bateria", "battery")
        ]

        self.sys_labels = {}

        for i, (label, key) in enumerate(info_fields):
            row, col = divmod(i, 3)
            card = ctk.CTkFrame(grid, fg_color=self.bg_color, corner_radius=10, border_width=1, border_color=self.acc_color)
            card.grid(row=row, column=col, padx=10, pady=10, sticky="nsew")
            card.grid_propagate(False)
            card.configure(height=120)

            ctk.CTkLabel(card, text=label, font=("Inter", 14, "bold"), text_color=self.acc_color).pack(pady=(10, 5))
            self.sys_labels[key] = ctk.CTkLabel(card, text="Detectando...", font=("Consolas", 12), text_color=self.text_color)
            self.sys_labels[key].pack(expand=True)

    # ---------- Otimização (com abas e cards) ----------
    def create_otimizacao_frame(self, parent):
        tabview = ctk.CTkTabview(parent, fg_color="transparent", segmented_button_selected_color=self.acc_color)
        tabview.pack(fill="both", expand=True)

        tab_ot = tabview.add("🚀 Otimização")
        self._create_otimizacao_cards(tab_ot)

        tab_gm = tabview.add("🎮 Gamer")
        self._create_gamer_cards(tab_gm)

    def _create_otimizacao_cards(self, parent):
        actions = [
            ("🧹 Limpeza de Cache", "sudo eopkg dc"),
            ("🔄 Reset de Swap", "sudo swapoff -a && sudo swapon -a"),
            ("✅ Verificar Erros", "sudo eopkg check"),
        ]
        self._create_action_grid(parent, actions, "ot")

    def _create_gamer_cards(self, parent):
        # Card especial para Modo Turbo
        turbo_card = ctk.CTkFrame(parent, fg_color=self.bg_color, corner_radius=10, border_width=2, border_color="#e11d48")
        turbo_card.pack(fill="x", pady=10, padx=10)
        ctk.CTkLabel(turbo_card, text="🔥 Modo Turbo", font=("Inter", 16, "bold"), text_color="#e11d48").pack(pady=5)
        self.turbo_btn = ctk.CTkButton(
            turbo_card,
            text="ATIVAR",
            fg_color="#e11d48",
            hover_color="#b91c1c",
            height=40,
            font=("Inter", 14, "bold"),
            command=self.toggle_turbo
        )
        self.turbo_btn.pack(pady=5)

        apps = [
            ("Steam", "steam"),
            ("Lutris", "lutris"),
            ("Heroic Launcher", "heroic-games-launcher-bin"),
            ("Bottles", "bottles"),
            ("Wine", "wine"),
            ("MangoHud", "mangohud"),
            ("Goverlay", "goverlay"),
        ]
        self._create_action_grid(parent, apps, "gm", is_install=True)

    def _create_action_grid(self, parent, items, tag, is_install=False):
        grid = ctk.CTkFrame(parent, fg_color="transparent")
        grid.pack(fill="both", expand=True, pady=10)
        for i in range(3):
            grid.columnconfigure(i, weight=1)

        for idx, (title, cmd) in enumerate(items):
            row, col = divmod(idx, 3)
            card = ctk.CTkFrame(grid, fg_color=self.bg_color, corner_radius=10, border_width=1, border_color=self.acc_color)
            card.grid(row=row, column=col, padx=10, pady=10, sticky="nsew")
            card.grid_propagate(False)
            card.configure(height=120)

            ctk.CTkLabel(card, text=title, font=("Inter", 14, "bold"), text_color=self.acc_color).pack(pady=(10, 5))
            btn_text = "Instalar" if is_install else "Executar"
            ctk.CTkButton(
                card,
                text=btn_text,
                fg_color=self.acc_color,
                command=lambda c=cmd, t=tag: self.run_action(c, t)
            ).pack(pady=5)

        self._add_console(parent, tag)

    # ---------- Rede (cards) ----------
    def create_rede_frame(self, parent):
        ctk.CTkLabel(parent, text="Rede", font=("Inter", 28, "bold"), text_color=self.acc_color).pack(anchor="w", pady=(0, 20))

        # Card Ping
        ping_card = ctk.CTkFrame(parent, fg_color=self.bg_color, corner_radius=10, border_width=2, border_color="#10b981")
        ping_card.pack(fill="x", pady=10, padx=10)
        ctk.CTkLabel(ping_card, text="📡 Ping", font=("Inter", 16, "bold"), text_color="#10b981").pack(pady=5)
        self.ping_label = ctk.CTkLabel(ping_card, text="-- ms", font=("Consolas", 20, "bold"), text_color="#10b981")
        self.ping_label.pack()
        ctk.CTkButton(ping_card, text="Iniciar Ping Contínuo", command=self.toggle_ping, fg_color=self.acc_color).pack(pady=5)

        dns_actions = [
            ("Cloudflare DNS", "1.1.1.1"),
            ("Google DNS", "8.8.8.8"),
            ("AdGuard DNS", "94.140.14.14"),
            ("DNS Automático", "auto")
        ]
        self._create_dns_grid(parent, dns_actions, "net")

    def _create_dns_grid(self, parent, items, tag):
        grid = ctk.CTkFrame(parent, fg_color="transparent")
        grid.pack(fill="both", expand=True, pady=10)
        for i in range(3):
            grid.columnconfigure(i, weight=1)

        for idx, (title, value) in enumerate(items):
            row, col = divmod(idx, 3)
            card = ctk.CTkFrame(grid, fg_color=self.bg_color, corner_radius=10, border_width=1, border_color=self.acc_color)
            card.grid(row=row, column=col, padx=10, pady=10, sticky="nsew")
            card.grid_propagate(False)
            card.configure(height=120)

            ctk.CTkLabel(card, text=title, font=("Inter", 14, "bold"), text_color=self.acc_color).pack(pady=(10, 5))
            if value == "auto":
                cmd = "nmcli dev mod $(nmcli -t -f DEVICE,STATE dev | grep connected | cut -d: -f1 | head -n1) ipv4.dns ''"
            else:
                cmd = f"nmcli dev mod $(nmcli -t -f DEVICE,STATE dev | grep connected | cut -d: -f1 | head -n1) ipv4.dns '{value}'"
            ctk.CTkButton(
                card,
                text="Aplicar",
                fg_color=self.acc_color,
                command=lambda c=cmd, t=tag: self.run_action(c, t)
            ).pack(pady=5)

        self._add_console(parent, tag)

    # ---------- Drivers (cards) ----------
    def create_drivers_frame(self, parent):
        ctk.CTkLabel(parent, text="Drivers", font=("Inter", 28, "bold"), text_color=self.acc_color).pack(anchor="w", pady=(0, 20))

        update_card = ctk.CTkFrame(parent, fg_color=self.bg_color, corner_radius=10, border_width=2, border_color=self.acc_color)
        update_card.pack(fill="x", pady=10, padx=10)
        ctk.CTkLabel(update_card, text="📦 Atualizar Sistema", font=("Inter", 16, "bold"), text_color=self.acc_color).pack(pady=5)
        ctk.CTkButton(
            update_card,
            text="Executar",
            fg_color=self.acc_color,
            command=lambda: self.run_action("sudo dnf upgrade -y", "drv")
        ).pack(pady=5)

        diag_actions = [
            ("PCI (Vídeo/Rede)", "lspci -nnk"),
            ("USB Conectados", "lsusb"),
            ("Módulos Kernel", "lsmod"),
            ("CPU Detalhada", "lscpu"),
            ("Firmware Erros", "sudo dmesg | grep -i firmware"),
        ]
        self._create_action_grid(parent, diag_actions, "drv")

    # ---------- Agente IA (cards) ----------
