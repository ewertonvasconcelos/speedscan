    def create_config_content(self, parent):
        """Tela de configurações com várias opções"""
        ctk.CTkLabel(parent, text="Configurações", font=("Inter", 28, "bold"), text_color=self.acc_color).pack(anchor="w", pady=(0, 30))

        # Nome de usuário
        frame_user = ctk.CTkFrame(parent, fg_color="transparent")
        frame_user.pack(fill="x", pady=10)
        ctk.CTkLabel(frame_user, text="Nome de usuário", font=("Inter", 14), text_color=self.text_color).pack(anchor="w")
        entry_user = ctk.CTkEntry(frame_user, placeholder_text="Seu nome", width=300)
        entry_user.insert(0, self.config.get("username", "ewerton"))
        entry_user.pack(anchor="w", pady=5)
        btn_reset_user = ctk.CTkButton(frame_user, text="Voltar para o padrão", fg_color="transparent", text_color=self.acc_color, command=lambda: entry_user.delete(0, "end") or entry_user.insert(0, "ewerton"))
        btn_reset_user.pack(anchor="w")

        # Idioma
        frame_lang = ctk.CTkFrame(parent, fg_color="transparent")
        frame_lang.pack(fill="x", pady=10)
        ctk.CTkLabel(frame_lang, text="Idioma de Interface", font=("Inter", 14), text_color=self.text_color).pack(anchor="w")
        lang_var = ctk.StringVar(value=self.config.get("language", "pt_BR"))
        lang_menu = ctk.CTkOptionMenu(frame_lang, values=list(languages.values()), variable=lang_var, width=300)
        lang_menu.pack(anchor="w", pady=5)
        # Mapear de volta para chave
        def get_lang_key():
            for k, v in languages.items():
                if v == lang_var.get():
                    return k
            return "pt_BR"
        # (salvamento será feito no botão Aplicar)

        # Escala da interface
        frame_scale = ctk.CTkFrame(parent, fg_color="transparent")
        frame_scale.pack(fill="x", pady=10)
        ctk.CTkLabel(frame_scale, text="Escala da interface *", font=("Inter", 14), text_color=self.text_color).pack(anchor="w")
        scale_var = ctk.StringVar(value=self.config.get("ui_scale", "auto"))
        scale_menu = ctk.CTkOptionMenu(frame_scale, values=list(scales.values()), variable=scale_var, width=300)
        scale_menu.pack(anchor="w", pady=5)

        # Tema da interface
        frame_theme = ctk.CTkFrame(parent, fg_color="transparent")
        frame_theme.pack(fill="x", pady=10)
        ctk.CTkLabel(frame_theme, text="Tema da interface", font=("Inter", 14), text_color=self.text_color).pack(anchor="w")
        theme_var = ctk.StringVar(value=self.config.get("theme", "default"))
        theme_options = ["default", "grey", "dark", "light"]
        theme_names = ["Padrão (Roxo)", "Cinza Profissional", "Escuro Total", "Claro Clean"]
        theme_menu = ctk.CTkOptionMenu(frame_theme, values=theme_names, width=300)
        # Mapear índice
        def get_theme_key():
            idx = theme_names.index(theme_menu.get())
            return theme_options[idx]
        theme_menu.set(theme_names[theme_options.index(self.config.get("theme", "default"))])
        theme_menu.pack(anchor="w", pady=5)

        # Abrir arquivo na guia
        frame_tab = ctk.CTkFrame(parent, fg_color="transparent")
        frame_tab.pack(fill="x", pady=10)
        ctk.CTkLabel(frame_tab, text="Abrir arquivo", font=("Inter", 14), text_color=self.text_color).pack(anchor="w")
        tab_var = ctk.StringVar(value="Na guia" if self.config.get("open_file_in_tab", False) else "Nova janela")
        tab_menu = ctk.CTkOptionMenu(frame_tab, values=["Na guia", "Nova janela"], variable=tab_var, width=300)
        tab_menu.pack(anchor="w", pady=5)

        # Nota sobre reinicialização
        ctk.CTkLabel(parent, text="* - As alterações serão aplicadas após reiniciar o aplicativo", font=("Inter", 10), text_color="#888888").pack(anchor="w", pady=20)

        # Botão Aplicar
        def apply_config():
            self.config["username"] = entry_user.get()
            # Idioma
            selected_lang = lang_var.get()
            for k, v in languages.items():
                if v == selected_lang:
                    self.config["language"] = k
                    break
            # Escala
            selected_scale = scale_var.get()
            for k, v in scales.items():
                if v == selected_scale:
                    self.config["ui_scale"] = k
                    break
            # Tema
            self.config["theme"] = get_theme_key()
            # Abrir arquivo
            self.config["open_file_in_tab"] = (tab_var.get() == "Na guia")

            # Salvar
            with open(CONFIG_FILE, "w") as f:
                json.dump(self.config, f)

            # Reiniciar se necessário (tema ou escala)
            if get_theme_key() != self.config.get("theme") or selected_scale != self.config.get("ui_scale"):
                python = sys.executable
                os.execl(python, python, *sys.argv)
            else:
                # apenas atualiza interface
                self.update_theme_vars()
                self.configure(fg_color=self.bg_color)
                self.sidebar.configure(fg_color=self.side_bg)
                # Recria frames para aplicar cores? (simplificado)
                # Por enquanto, apenas avisa
                print("Configurações aplicadas. Algumas alterações podem precisar de reinicialização.")

        btn_apply = ctk.CTkButton(parent, text="Aplicar", fg_color=self.acc_color, command=apply_config, width=200, height=40)
        btn_apply.pack(pady=20)

