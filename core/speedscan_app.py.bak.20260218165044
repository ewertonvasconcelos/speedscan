from datetime import datetime

# Configurações
CONFIG_FILE = os.path.expanduser("~/.speedscan_conf")
ICON_PATH = os.path.expanduser("~/speedscan/icon.png")

def get_config():
    if os.path.exists(CONFIG_FILE):
        try:
            with open(CONFIG_FILE, "r") as f:
                return json.load(f)
        except:
            pass
    return {
        "theme": "default",
        "username": "ewerton",
        "language": "pt_BR",
        "ui_scale": "auto",
        "open_file_in_tab": False
    }

conf = get_config()

themes = {
    "default": {"mode": "dark", "bg": "#1e293b", "side": "#0f172a", "acc": "#a855f7", "text": "#ffffff"},
    "grey":    {"mode": "light", "bg": "#d1d5db", "side": "#374151", "acc": "#4b5563", "text": "#111827"},
    "dark":    {"mode": "dark", "bg": "#080808", "side": "#000000", "acc": "#10b981", "text": "#ffffff"},
    "light":   {"mode": "light", "bg": "#ffffff", "side": "#f8fafc", "acc": "#2563eb", "text": "#0f172a"}
}

# Mapeamento de idiomas (placeholder)
languages = {
    "pt_BR": "Português Brasileiro",
    "en_US": "English (US)",
    "es_ES": "Español"
}

# Escalas disponíveis
scales = {
    "auto": "Automático",
    "100": "100%",
    "125": "125%",
    "150": "150%"
}

class SpeedScan(ctk.CTk):
    def __init__(self):
        super().__init__()
        self.SO = platform.system()
        self.config = conf
        self.update_theme_vars()
        self.title("SpeedScan Beta")
        self.geometry("1200x950")
        self.minsize(1000, 700)
        self.configure(fg_color=self.bg_color)

        # Aplicar escala inicial
        self.apply_ui_scale()

        # Variáveis de estado
        self.turbo_active = False
        self.consoles_visible = {}
        self.ping_active = False
        self.current_module = None  # para navegação

        # Layout principal: sidebar + conteúdo
        self.grid_columnconfigure(1, weight=1)
        self.grid_rowconfigure(0, weight=1)

        # Sidebar (esquerda) - estilo ONLYOFFICE
        self.sidebar = ctk.CTkFrame(self, width=220, corner_radius=0, fg_color=self.side_bg)
        self.sidebar.grid(row=0, column=0, sticky="nsew")
        self.sidebar.grid_propagate(False)

        # Container de conteúdo (direita)
        self.container = ctk.CTkFrame(self, fg_color="transparent")
        self.container.grid(row=0, column=1, sticky="nsew", padx=20, pady=20)
        self.container.grid_columnconfigure(0, weight=1)
        self.container.grid_rowconfigure(0, weight=1)

        # Dicionário de frames principais
        self.main_frames = {}  # "home", "config", "agente" (futuro)
        self.module_frames = {}  # "sistema", "otimizacao", "rede", "drivers"

        # Criar botões da sidebar
        self.create_sidebar()

        # Criar frames principais
        self.create_main_frames()

        # Criar frames dos módulos (funcionalidades)
        self.create_module_frames()

        # Mostrar frame inicial (Home)
        self.show_main_frame("home")

        # Atalho de rolagem
        self.bind_all("<MouseWheel>", self._on_mousewheel)

        # Iniciar monitoramento de hardware em background
        threading.Thread(target=self.hardware_monitor, daemon=True).start()

    def update_theme_vars(self):
        t = themes.get(self.config["theme"], themes["default"])
        ctk.set_appearance_mode(t["mode"])
        self.bg_color = t["bg"]
        self.side_bg = t["side"]
        self.acc_color = t["acc"]
        self.text_color = t["text"]

    def apply_ui_scale(self):
        scale = self.config.get("ui_scale", "auto")
        if scale == "auto":
            # Deixa o sistema decidir
            ctk.set_widget_scaling(1.0)
        else:
            ctk.set_widget_scaling(float(scale) / 100)

    def create_sidebar(self):
        # Título ONLYOFFICE (simulado)
        title_frame = ctk.CTkFrame(self.sidebar, fg_color="transparent")
        title_frame.pack(pady=(20, 30), fill="x")
        ctk.CTkLabel(title_frame, text="⚡ SpeedScan", font=("Inter", 18, "bold"), text_color=self.acc_color).pack()

        # Botões da sidebar
        self.side_btns = {}

        # Página Inicial
        self.side_btns["home"] = self.add_sidebar_btn("🏠", "Página Inicial", "home")

        # Agente de IA
        self.side_btns["agente"] = self.add_sidebar_btn("🤖", "Agente de IA", "agente")

        # Configurações
        self.side_btns["config"] = self.add_sidebar_btn("⚙️", "Configurações", "config")

        # Sobre (abre pop-up)
        self.side_btns["sobre"] = self.add_sidebar_btn("ℹ️", "Sobre", "sobre", is_popup=True)

    def add_sidebar_btn(self, icon, text, target, is_popup=False):
        frame = ctk.CTkFrame(self.sidebar, fg_color="transparent")
        frame.pack(pady=5, fill="x", padx=10)
        if is_popup:
            cmd = self.show_about_popup
        else:
            cmd = lambda: self.show_main_frame(target)
        btn = ctk.CTkButton(
            frame,
            text=f"{icon}  {text}",
            anchor="w",
            height=40,
            fg_color="transparent",
            hover_color=self.acc_color,
            font=("Inter", 13),
            command=cmd
        )
        btn.pack(fill="x")
        return btn

    def show_main_frame(self, target):
        """Mostra um dos frames principais (home, config, agente)"""
        # Esconder todos os frames principais
        for frame in self.main_frames.values():
            frame.pack_forget()
        # Mostrar o frame alvo
        self.main_frames[target].pack(fill="both", expand=True)
        # Se for home, garantir que o grid de módulos esteja visível
        if target == "home":
            self.show_module_grid()

    def show_module_grid(self):
        """Na home, mostra o grid de módulos e esconde qualquer módulo ativo"""
        if hasattr(self, 'current_module_frame') and self.current_module_frame:
            self.current_module_frame.pack_forget()
        self.home_grid.pack(fill="both", expand=True)
        self.current_module = None

    def show_module(self, module_name):
        """Mostra um módulo específico (sistema, otimizacao, rede, drivers)"""
        # Esconde o grid da home
        self.home_grid.pack_forget()
        # Se já havia um módulo, esconde
        if self.current_module_frame:
            self.current_module_frame.pack_forget()
        # Mostra o novo módulo
        self.module_frames[module_name].pack(fill="both", expand=True)
        self.current_module_frame = self.module_frames[module_name]
        self.current_module = module_name

    def create_main_frames(self):
        """Cria os frames principais: home, config, agente"""
        # Frame Home (com grid de módulos)
        self.main_frames["home"] = ctk.CTkFrame(self.container, fg_color="transparent")
        self.create_home_content(self.main_frames["home"])

        # Frame Configurações
        self.main_frames["config"] = ctk.CTkScrollableFrame(self.container, fg_color="transparent")
        self.create_config_content(self.main_frames["config"])

        # Frame Agente de IA (placeholder)
        self.main_frames["agente"] = ctk.CTkFrame(self.container, fg_color="transparent")
        self.create_agente_content(self.main_frames["agente"])

    def create_home_content(self, parent):
        """Conteúdo da home: grid de módulos e botão voltar (quando em módulo)"""
        # Frame para o grid (inicialmente visível)
        self.home_grid = ctk.CTkFrame(parent, fg_color="transparent")
        self.home_grid.pack(fill="both", expand=True)

        # Título
        ctk.CTkLabel(self.home_grid, text="Página Inicial", font=("Inter", 28, "bold"), text_color=self.acc_color).pack(anchor="w", pady=(0, 30))

        # Grid 2x2 de cards
        grid_frame = ctk.CTkFrame(self.home_grid, fg_color="transparent")
        grid_frame.pack(expand=True, fill="both")

        # Configurar grid
        for i in range(2):
            grid_frame.columnconfigure(i, weight=1, uniform="col")
        for j in range(2):
            grid_frame.rowconfigure(j, weight=1, uniform="row")

        cards = [
            ("💻 Sistema", "sistema"),
            ("🚀 Otimização", "otimizacao"),
            ("🌐 Rede", "rede"),
            ("🛠️ Drivers", "drivers")
        ]

        for idx, (text, module) in enumerate(cards):
            row, col = divmod(idx, 2)
            card = ctk.CTkFrame(grid_frame, fg_color=self.bg_color, corner_radius=15, border_width=2, border_color=self.acc_color)
            card.grid(row=row, column=col, padx=20, pady=20, sticky="nsew")
            card.bind("<Button-1>", lambda e, m=module: self.show_module(m))

            label = ctk.CTkLabel(card, text=text, font=("Inter", 24, "bold"), text_color=self.acc_color)
            label.pack(expand=True)
            label.bind("<Button-1>", lambda e, m=module: self.show_module(m))

        # Frame para o botão voltar (inicialmente vazio)
        self.back_button_frame = ctk.CTkFrame(parent, fg_color="transparent", height=40)
        self.back_button_frame.pack(fill="x", pady=10)
        self.back_button = ctk.CTkButton(
            self.back_button_frame,
            text="← Voltar à Página Inicial",
            fg_color="transparent",
            text_color=self.acc_color,
            hover=False,
            command=self.show_module_grid
        )
        # Inicialmente escondido
        self.back_button.pack_forget()

        # Quando um módulo for mostrado, o botão voltar será exibido via show_module

    def create_module_frames(self):
        """Cria os frames para cada módulo (sistema, otimizacao, rede, drivers)"""
        # Sistema
        self.module_frames["sistema"] = ctk.CTkScrollableFrame(self.container, fg_color="transparent")
        self.create_sistema_content(self.module_frames["sistema"])

        # Otimização (com abas internas: Otimização e Gamer)
        self.module_frames["otimizacao"] = ctk.CTkFrame(self.container, fg_color="transparent")
        self.create_otimizacao_content(self.module_frames["otimizacao"])

        # Rede
        self.module_frames["rede"] = ctk.CTkScrollableFrame(self.container, fg_color="transparent")
        self.create_rede_content(self.module_frames["rede"])

        # Drivers
        self.module_frames["drivers"] = ctk.CTkScrollableFrame(self.container, fg_color="transparent")
        self.create_drivers_content(self.module_frames["drivers"])

