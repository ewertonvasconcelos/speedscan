{
    "app-id": "org.speedscan.SpeedScan",
    "runtime": "org.freedesktop.Platform",
    "runtime-version": "23.08",
    "sdk": "org.freedesktop.Sdk",
    "command": "speedscan",
    "finish-args": [
        "--share=ipc",
        "--socket=x11",
        "--socket=wayland",
        "--device=dri",
        "--share=network"
    ],
    "modules": [
        {
            "name": "speedscan",
            "buildsystem": "simple",
            "build-commands": [
                "install -Dm755 speedscan /app/bin/speedscan",
                "install -Dm644 icon.png /app/share/icons/hicolor/128x128/apps/org.speedscan.SpeedScan.png",
                "install -Dm644 org.speedscan.SpeedScan.desktop /app/share/applications/org.speedscan.SpeedScan.desktop"
            ],
            "sources": [
                {
                    "type": "file",
                    "path": "../dist/speedscan"
                },
                {
                    "type": "file",
                    "path": "icon.png"
                },
                {
                    "type": "file",
                    "path": "org.speedscan.SpeedScan.desktop"
                }
            ]
        }
    ]
}
