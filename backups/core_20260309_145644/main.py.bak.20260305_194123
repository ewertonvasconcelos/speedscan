    def _run_linux_command(self, cmd, log, use_sudo=True):
        proc = self.app.runner.run(cmd, use_sudo=use_sudo, parent=self.app)
        if proc:
            for line in proc.stdout:
                self.app.after(0, lambda l=line: log.insert("end", l))
            proc.wait()
            return True
        return False

    def run_cache_clean(self, log):
        """Limpa cache de melÃ³ria (Linux)."""
        log.delete("1.0", "end")
        log.insert("end", "â™€ Limpando cache de memÃ³ria...\n")
        if self.app.SO != "Linux":
            log.insert("end", "âš  OperaÃ§Ã£o apenas Ã©implementada para Linux.\n")
            return
        success = self._run_linux_command(["sh", "-c", "sync; echo 3 > /proc/sys/vm/drop_caches"], log, use_sudo=True)
        if success:
            log.insert("end", "â”Œ Cache limpo com sucesso.\n")
        else:
            log.insert("end", "âš Erro ao limpar cache. Verifique permissÃµes.\n")

    def run_swap_reset(self, log):
        """Reseta da partiÃ§Ã£o de troca (Swap )."""
        log.delete("1.0", "end")
        log.insert("end", "ðŸ”¤ Reativando swap...\n")
        if self.app.SO != "Linux":
            log.insert("end", "âš  OperaÃ§Ã£o apenas implementada para Linux.\n")
            return
        # Desativa swap
        log.insert("end", "Desativando swap...\n")
        self._run_linux_command(["sudo", "swapoff", "-a"], log, use_sudo=True)
        # Ativa swap
        log.insert("end", "Ativando swap...\n")
        self._run_linux_command(["sudo", "swapon", "-a"], log, use_sudo=True)
        log.insert("end", "âœ… Swap reinicializado.\n")

