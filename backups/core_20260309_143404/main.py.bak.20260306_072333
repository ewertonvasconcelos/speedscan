    def widget_uptime(self):
        import psutil
        from datetime import datetime
        boot_time = datetime.fromtimestamp(psutil.boot_time())
        delta = datetime.now() - boot_time
        days = delta.days
        hours, remainder = divmod(delta.seconds, 3600)
        minutes, seconds = divmod(remainder, 60)
        return f"{days}d {hours}h {minutes}m"

    def widget_cpu(self):
        import psutil
        return f"{psutil.cpu_percent(interval=0.1)}%"

    def widget_ram(self):
        import psutil
        mem = psutil.virtual_memory()
        return f"{mem.percent}% ({mem.used // (1024**3)} GB / {mem.total // (1024**3)} GB)"

    def widget_gpu(self):
        try:
            import subprocess
            result = subprocess.run(['lspci', '|', 'grep', '-i', 'vga'], capture_output=True, text=True, shell=True)
            if result.stdout:
                return result.stdout.strip().split('\n')[0][:50]
            else:
                return "N/A"
        except:
            return "N/A"

    def widget_disks(self):
        import psutil
        disks = psutil.disk_usage('/')
        return f"{disks.percent}% ({disks.used // (1024**3)} GB / {disks.total // (1024**3)} GB)"

    def widget_battery(self):
        import psutil
        battery = psutil.sensors_battery()
        if battery:
            percent = battery.percent
            plugged = "Carregando" if battery.power_plugged else "Descarregando"
            return f"{percent}% ({plugged})"
        return "Sem bateria"

    def widget_temps(self):
        import psutil
        temps = psutil.sensors_temperatures()
        if temps:
            for name, entries in temps.items():
                if entries:
                    return f"{entries[0].current}°C"
        return "N/A"

    def widget_health(self):
        import psutil
        cpu_percent = psutil.cpu_percent(interval=0.1)
        mem_percent = psutil.virtual_memory().percent
        if cpu_percent < 50 and mem_percent < 50:
            return "Bom"
        elif cpu_percent < 80 and mem_percent < 80:
            return "Ok"
        else:
            return "Alto uso"
