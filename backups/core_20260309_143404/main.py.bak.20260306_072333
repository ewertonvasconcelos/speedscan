        if self.app.SO != "Linux":
            log.insert("end", "⚠️ Operação apenas implementada para Linux.\n")
            return
        self._run_linux_command(["dmesg", "-x", "--level=crit", "--format=datesec", "tail", "-20"], log, use_sudo=False)
        log.insert("end", "✅ Verificação concluída.\n")

