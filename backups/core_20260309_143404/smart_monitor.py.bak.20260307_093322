#!/usr/bin/env python3
# -*- coding: utf-8 -*-

# Módulo de monitoramento S.M.A.R.T. dos discos
# Versão 1.0.0

import logging
import subprocess
import re

from core import config


class SmartMonitor:
    def __init__(self):
        self.disk_status = {}

    def get_smart_info(self, disk="/dev/sda"):
        """Returna informações S.M.A.R.T. do disco especificado."""
        try:
            result = subprocess.run(
                ["sudo", "smartctl", "-H", disk],
                capture_output=True, text=True, timeout=5
            )
            return result.stdout
        except Exception as e:
            logging.error(f"Erro ao obter info SMART do disco {disk}: {e}")
            return None

    def get_summary_text(self):
        """Gera um resumo textual do status S.M.A.R.T. de todos os discos."""
        try:
            out = subprocess.run(["lsblk", "-d", "-o", "NAME"], capture_output=True, text=True)
            disks = out.stdout.splitlines()[1:]  # ignora o cab^|alho "NAME"
            summary = []
            for disk in disks:
                disk = disk.strip()
                if not disk:
                    continue
                smart = self.get_smart_info(f"/dev/{disk}")
                if smart:
                    match = re.search(r"SMART  overall-health self-assessment test result: (\w+)", smart)
                    if match:
                        status = match.group(1)
                        summary.append(f"{disk}: {status}")
                    else:
                        summary.append(f"{disk}: Desconhecido")
                else:
                    summary.append(f"{disk}: Não suportado")
            return "\n".join(summary) if summary else "Nenhum disco encontrado"
        except Exception as e:
            logging.error(f"Erro ao gerar resumo SMART: {e}")
            return "Erro ao obter informações S.M.A.R.T."

    def get_status_color(self):
        """Retorna a nome da cor correspondente ao status geral dos discos."""
        try:
            out = subprocess.run(["lsblk", "-d", "-o", "NAME"], capture_output=True, text=True)
            disks = out.stdout.splitlines()[1:]
            any_failed = False
            any_unknown = False
            for disk in disks:
                disk = disk.strip()
                if not disk:
                    continue
                smart = self.get_smart_info(f"/dev/{disk}")
                if smart:
                    if "FAILED" in smart:
                        any_failed = True
                    elif "PASSED" not in smart:
                        any_unknown = True
                else:
                    any_unknown = True
            if any_failed:
                return "red"
            if any_unknown:
                return "yellow"
            return "green"
        except Exception as e:
            logging.error(f"Erro ao obter cor do status SMART: {e}")
            return "yellow"
