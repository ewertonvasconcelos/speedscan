class ActionHandler:
    def __init__(self, app):
        self.app = app

    # ---------- NOWOS MГ‰TODOS PARA O CANDE DE OTIMIZAГ‡ГѓO ----------
    def _run_linux_command(self, cmd, log, use_sudo=True):
        proc = self.app.runner.run(cmd, use_sudo=use_sudo, parent=self.app)
        if proc:
            for line in proc.stdout:
                self.app.after(0, lambda l=line: log.insert("end", l))
            proc.wait()
            return True
        return False

    def run_cache_clean(self, log):
        """Limpa cache de melГіria (Linux)."""
        log.delete("1.0", "end")
        log.insert("end", "в™Ђ Limpando cache de memГіria...\n")
        if self.app.SO != "Linux":
            log.insert("end", "вљ  OperaГ§ГЈo apenas Г©implementada para Linux.\n")
            return
        success = self._run_linux_command(["sh", "-c", "sync; echo 3 > /proc/sys/vm/drop_caches"], log, use_sudo=True)
        if success:
            log.insert("end", "в”Њ Cache limpo com sucesso.\n")
        else:
            log.insert("end", "вљђ Erro ao limpar cache. Verifique permissГµes.\n")

    def run_swap_reset(self, log):
        """Reseta da partiГ§ГЈo de troca (Swap )."""
        log.delete("1.0", "end")
        log.insert("end", "рџ”¤ Reativando swap...\n")
        if self.app.SO != "Linux":
            log.insert("end", "вљ  OperaГ§ГЈo apenas implementada para Linux.\n")
            return
        # Desativa swap
        log.insert("end", "Desativando swap...\n")
        self._run_linux_command(["sudo", "swapoff", "-a"], log, use_sudo=True)
        # Ativa swap
        log.insert("end", "Ativando swap...\n")
        self._run_linux_command(["sudo", "swapon", "-a"], log, use_sudo=True)
        log.insert("end", "вњ… Swap reinicializado.\n")

