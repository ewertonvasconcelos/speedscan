    def _load_config(self):
        """Load configuration from JSON file or use default."""
        if config.CONFIG_FILE.exists():
            try:
                with open(config.CONFIG_FILE, 'r', encoding='utf-8') as f:
                    cfg = json.load(f)
                # guarantee that keys exist
                if 'theme' not in cfg:
                    cfg['theme'] = config.DEFAULT_CONFIG['theme']
                if 'expert_level' not in cfg:
                    cfg['expert_level'] = config.DEFAULT_CONFIG['expert_level']
                if 'ui_scale' not in cfg:
                    cfg['ui_scale'] = config.DEFAULT_CONFIG['ui_scale']
                if 'window_state' not in cfg:
                    cfg['window_state'] = config.DEFAULT_CONFIG['window_state']
                return cfg
            except Exception as e:
                logging.error(f"Error loading config: {e}")
                return config.DEFAULT_CONFIG.copy()
        return config.DEFAULT_CONFIG.copy()

    def _save_config(self):
        """Save current configuration to JSON file."""
        try:
            with open(config.CONFIG_FILE, 'w', encoding='utf-8') as f:
                json.dump(self.config, f, indent=2, ensure_ascii=False)
        except Exception as e:
            logging.error(f"Error saving config: {e}")

    def update_theme_vars(self):
        """Update color variables based on selected theme."""
        t = config.THEMES.get(self.config["theme"], config.THEMES["default"])
        ctk.set_appearance_mode(t["mode"])
        self.bg_color = t["bg"]
        self.side_bg = t["side"]
        self.acc_color = t["acc"]
        self.text_color = t["text"]
        self.light_bg = self._lighten_color(self.bg_color, 0.2)

    def _lighten_color(self, hex_color, factor):
        """Lighten a hex color by a factor."""
        h = hex_color.lstrip('#')
        r, g, b = int(h[0:2], 16), int(h[2:4], 16), int(h[4:6], 16)
        r = min(255, int(r + (255 - r) * factor))
        g = min(255, int(g + (255 - g) * factor))
        b = min(255, int(b + (255 - b) * factor))
        return f"#{r:02x}{g:02x}{b:02x}"

    def apply_ui_scale(self):
        """Apply interface scale according to configuration."""
        scale = self.config.get("ui_scale", "auto")
        if scale == "auto":
            ctk.set_widget_scaling(1.0)
        else:
            ctk.set_widget_scaling(float(scale)/100)

    def round_image(self, path, size=(96,96), radius=20):
        """Round image corners."""
        try:
            img = Image.open(path).convert("RGBA").resize(size, Image.Resampling.LANCZOS)
            mask = Image.new("L", size, 0)
            ImageDraw.Draw(mask).rounded_rectangle((0,0)+size, radius=radius, fill=255)
            result = Image.new("RGBA", size)
            result.paste(img, (0,0), mask)
            return ctk.CTkImage(result, size=size)
        except:
            return None

